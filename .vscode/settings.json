{
  "markdown-pdf.outputDirectory": "output/pdf",
  "markdown-pdf.outputDirectoryRelativePathFile": true,
  "markdown-pdf.styles": [
    "docs/markdown-pdf.css"
  ],
  "markdown-pdf.stylesRelativePathFile": true,
  "markdown-pdf.format": "A4",
  "markdown-pdf.displayHeaderFooter": true,
  "markdown-pdf.headerTemplate": "<div style=\"font-size:8px;margin-left:1cm;color:#607080\">Excavator3000 Project Guide</div><div style=\"font-size:8px;margin-left:auto;margin-right:1cm;color:#607080\">%%ISO-DATE%%</div>",
  "markdown-pdf.footerTemplate": "<div style=\"font-size:8px;margin:0 auto;color:#607080\"><span class='pageNumber'></span> / <span class='totalPages'></span></div>",
  "markdown-pdf.margin.top": "1.8cm",
  "markdown-pdf.margin.bottom": "1.6cm",
  "markdown-pdf.margin.left": "1.6cm",
  "markdown-pdf.margin.right": "1.6cm",
  "markdown-pdf.printBackground": true
}
